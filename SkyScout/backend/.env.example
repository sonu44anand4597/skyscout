PORT=5000
MONGODB_URI=
SERPAPI_API_KEY=your_serpapi_api_key_here
DNS_SERVERS=
CLIENT_ORIGIN=http://127.0.0.1:5173
ML_SERVICE_URL=http://127.0.0.1:8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_API_KEY=
FARE_INTELLIGENCE_ENABLED=true
FARE_INTELLIGENCE_MAX_GROUNDED_REQUESTS=18
FARE_INTELLIGENCE_COOLDOWN_SECONDS=21600

# Set true only if your Google agreement explicitly permits storing grounded reports.
GEMINI_GROUNDED_STORAGE_AUTHORIZED=false

# Browser origins must be exact. Production requires HTTPS origins.
# CLIENT_ORIGINS=https://your-skyscout-host.example
NODE_ENV=development
SESSION_SAME_SITE=Lax
# Use the actual hop count only when direct API access is restricted.
TRUST_PROXY=0
# Disable in API replicas and run `npm run worker` separately in production.
MONITORING_ENABLED=true
# Optional local spend cap, shared across instances; set from your actual plan.
SERPAPI_MAX_DAILY_REQUESTS=
# Optional private diagnostics; generate a long random token, backend only.
OPERATIONS_TOKEN=
